# Extra HTTP headers. GitHub Pages IGNORES this file (it can't set custom headers).
# Netlify and Cloudflare Pages DO read it. Only game.html may be shown inside X's frame.
# Each path is listed on its own on purpose (two matching rules could both be sent = X blocked).

/game.html
  Content-Security-Policy: frame-ancestors 'self' https://x.com https://*.x.com https://twitter.com https://*.twitter.com

/
  Content-Security-Policy: frame-ancestors 'self'

/index.html
  Content-Security-Policy: frame-ancestors 'self'
